    },
    {
      "id": 5,
      "title": "F1 score",
      "description": "Fixed score from models/metrics.json. It is not measured on live traffic, because live messages have no true labels.",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "spam_model_test_score{metric=\"f1\"}",
          "legendFormat": "f1"
        }
